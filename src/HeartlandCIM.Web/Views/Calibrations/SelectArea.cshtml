@model SelectAreaViewModel
@{
    ViewData["Title"] = "Select Area";
}
<h2 class="page-title"><i class="fa-solid fa-layer-group me-2"></i>Select Area</h2>

@if (!Model.CycleConfirmed)
{
    <div class="system-not-ready">
        <i class="fa-solid fa-triangle-exclamation fa-2x mb-2"></i>
        <h4 class="mb-1">System Not Ready</h4>
        <p class="mb-0">No calibration cycle has been confirmed. Please open a cycle in Admin &rarr; Area Management.</p>
        <a class="btn btn-navy mt-3" href="@Url.Action("AreaManagement", "Admin")">Go to Area Management</a>
    </div>
}
else if (!Model.Areas.Any())
{
    <div class="alert alert-info">No areas are currently Open for cycle <strong>@Model.CurrentCycle</strong>.</div>
}
else
{
    <p class="text-muted">Cycle <strong>@Model.CurrentCycle</strong> &middot; select an area to work its instruments.</p>
    <div class="row g-3">
        @foreach (var a in Model.Areas)
        {
            <div class="col-md-6">
                <a class="text-decoration-none" href="@Url.Action("SelectInstrument", "Calibrations", new { area = a.Area })">
                    <div class="hcim-card area-card p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0 text-navy" style="color:var(--navy)">@a.Area</h5>
                            <span class="badge bg-secondary">@a.Total instruments</span>
                        </div>
                        <div class="progress" style="height: 22px;">
                            <div class="progress-bar bg-secondary" style="width:@a.NotStartedPct%" title="Not Started">@(a.NotStartedPct > 8 ? a.NotStartedPct + "%" : "")</div>
                            <div class="progress-bar" style="width:@a.RemovedPct%;background:var(--red)" title="Removed">@(a.RemovedPct > 8 ? a.RemovedPct + "%" : "")</div>
                            <div class="progress-bar" style="width:@a.InstalledPct%;background:var(--accent)" title="Installed">@(a.InstalledPct > 8 ? a.InstalledPct + "%" : "")</div>
                            <div class="progress-bar" style="width:@a.VerifiedPct%;background:var(--green)" title="Verified">@(a.VerifiedPct > 8 ? a.VerifiedPct + "%" : "")</div>
                        </div>
                        <div class="progress-legend mt-2">
                            <span><span class="legend-dot" style="background:#6c757d"></span>Not Started (@a.NotStarted)</span>
                            <span><span class="legend-dot" style="background:var(--red)"></span>Removed (@a.Removed)</span>
                            <span><span class="legend-dot" style="background:var(--accent)"></span>Installed (@a.Installed)</span>
                            <span><span class="legend-dot" style="background:var(--green)"></span>Verified (@a.Verified)</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
