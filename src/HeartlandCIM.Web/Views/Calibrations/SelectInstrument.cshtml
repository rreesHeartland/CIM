@model SelectInstrumentViewModel
@{
    ViewData["Title"] = "Select Instrument";
}
<h2 class="page-title"><i class="fa-solid fa-list-check me-2"></i>@Model.Area &mdash; Instruments Due</h2>
<p class="text-muted">Cycle <strong>@Model.CurrentCycle</strong> &middot; cutoff date <strong>@Model.CutOffDate.ToString("MMM d, yyyy")</strong></p>

<div class="hcim-card p-0 mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:80px">Photo</th>
                    <th>Tag</th>
                    <th>Status</th>
                    <th>Access Requirement</th>
                    <th>Next Cal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.DueInstruments.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No instruments due in this area.</td></tr>
                }
                @foreach (var i in Model.DueInstruments)
                {
                    <tr style="cursor:pointer" onclick="location.href='@Url.Action("InstrumentDetails", "Calibrations", new { id = i.Id })'">
                        <td>
                            @if (!string.IsNullOrEmpty(i.Detail_PicPath))
                            {
                                <img src="@i.Detail_PicPath" class="thumb" alt="@i.Title" />
                            }
                            else
                            {
                                <span class="thumb d-inline-flex align-items-center justify-content-center"><i class="fa-solid fa-image text-muted"></i></span>
                            }
                        </td>
                        <td class="fw-bold">@i.Title<br /><small class="text-muted">@i.InstrumentType</small></td>
                        <td><span class="status-badge @UiHelpers.StatusCssClass(i.Status)">@i.Status</span></td>
                        <td class="@UiHelpers.AccessCssClass(i.AccessRequirement)">@i.AccessRequirement</td>
                        <td>@(i.Next_Cal_Date?.ToString("MMM d, yyyy") ?? "-")</td>
                        <td class="text-end"><i class="fa-solid fa-chevron-right text-muted"></i></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<h5 class="page-title mt-4"><i class="fa-solid fa-circle-check me-2 text-success"></i>Completed / Verified Instruments</h5>
<div class="hcim-card p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Tag</th><th>Verified By</th><th>Verified Time</th></tr>
            </thead>
            <tbody>
                @if (!Model.VerifiedInstruments.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">No verified instruments yet.</td></tr>
                }
                @foreach (var i in Model.VerifiedInstruments)
                {
                    <tr>
                        <td class="fw-bold">@i.Title</td>
                        <td>@i.Feedback_Verified_Tech</td>
                        <td>@i.Feedback_Verified_Time?.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
