@{
    ViewData["Title"] = "Admin";
}
<h2 class="page-title"><i class="fa-solid fa-gears me-2"></i>Administration</h2>

<div class="activity-grid">
    <a class="activity-card" href="@Url.Action("AreaManagement", "Admin")">
        <span class="icon"><i class="fa-solid fa-map-location-dot"></i></span>
        <h5>Area Management</h5>
        <p class="text-muted mb-0">Set cycle &amp; open/close areas</p>
    </a>

    <a class="activity-card" href="javascript:void(0)" onclick="document.getElementById('calDatesModalBtn').click()">
        <span class="icon"><i class="fa-solid fa-calendar-day"></i></span>
        <h5>Update Next Calibration Dates</h5>
        <p class="text-muted mb-0">Recalculate from Last Cal Date (CCP +6mo, CP +12mo)</p>
    </a>

    <a class="activity-card" href="javascript:void(0)" onclick="document.getElementById('resetModalBtn').click()">
        <span class="icon"><i class="fa-solid fa-rotate-left" style="color:var(--red)"></i></span>
        <h5>Reset Calibration Cycle</h5>
        <p class="text-muted mb-0">Clear all remove/install/verify progress</p>
    </a>
</div>

<button id="calDatesModalBtn" class="d-none" data-bs-toggle="modal" data-bs-target="#calDatesModal"></button>
<button id="resetModalBtn" class="d-none" data-bs-toggle="modal" data-bs-target="#resetModal"></button>

@* Update cal dates confirm *@
<div class="modal fade" id="calDatesModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Update Next Calibration Dates</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                This will set <strong>Next Cal Date</strong> for every instrument based on its Last Cal Date
                (CCP = +6 months, CP = +12 months). Continue?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="UpdateCalDates" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-navy">Update Dates</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* Reset cycle confirm (dangerous) *@
<div class="modal fade" id="resetModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title"><i class="fa-solid fa-triangle-exclamation me-2"></i>Reset Calibration Cycle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p class="text-danger fw-bold">This is a destructive operation.</p>
                It clears all Removed, Installed and Verified technicians &amp; timestamps for <strong>every</strong> instrument.
                This cannot be undone. Continue?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="ResetCycle" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-red">Yes, Reset Everything</button>
                </form>
            </div>
        </div>
    </div>
</div>
