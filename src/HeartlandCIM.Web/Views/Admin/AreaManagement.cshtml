@model AreaManagementViewModel
@{
    ViewData["Title"] = "Area Management";
}
<h2 class="page-title"><i class="fa-solid fa-map-location-dot me-2"></i>Area Management</h2>

<div class="hcim-card p-4 mb-4">
    <h5 class="mb-3">Calibration Cycle</h5>
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Select Cycle</label>
            <form asp-action="SetCycle" method="post" class="d-flex gap-2" id="setCycleForm">
                @Html.AntiForgeryToken()
                <select name="cycle" class="form-select">
                    @foreach (var c in Model.CycleOptions)
                    {
                        <option value="@c" selected="@(c == Model.CurrentCycle)">@c</option>
                    }
                </select>
                <button type="submit" class="btn btn-navy">Set</button>
            </form>
        </div>
        <div class="col-md-4">
            <div class="mb-1 small text-muted">Current cycle</div>
            <div class="fw-bold fs-5 text-primary">@(string.IsNullOrEmpty(Model.CurrentCycle) ? "— none —" : Model.CurrentCycle)</div>
        </div>
        <div class="col-md-3 text-md-end">
            <form asp-action="ResetCycleLabel" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger" @(Model.AnyOpen ? "disabled" : "")
                        title="@(Model.AnyOpen ? "Close all areas before resetting" : "Clear the cycle")">
                    <i class="fa-solid fa-rotate-left me-1"></i>Reset Cycle
                </button>
            </form>
        </div>
    </div>
    @if (Model.AnyOpen)
    {
        <div class="form-text mt-2"><i class="fa-solid fa-circle-info me-1"></i>Reset is disabled while one or more areas are Open.</div>
    }
</div>

<div class="hcim-card p-0">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Area</th><th>Cycle</th><th>Status</th><th style="width:280px">Update</th></tr>
            </thead>
            <tbody>
                @if (!Model.Areas.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No areas defined. Add rows to the AreaStatus table.</td></tr>
                }
                @foreach (var a in Model.Areas)
                {
                    <tr>
                        <td class="fw-bold">@a.Title</td>
                        <td>@(string.IsNullOrEmpty(a.Current_Cycle) ? "—" : a.Current_Cycle)</td>
                        <td>
                            <span class="badge @(a.Status == "Open" ? "bg-success" : "bg-secondary")">@a.Status</span>
                        </td>
                        <td>
                            <form asp-action="SetAreaStatus" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <select name="status" class="form-select form-select-sm">
                                    <option value="Open" selected="@(a.Status == "Open")">Open</option>
                                    <option value="Closed" selected="@(a.Status == "Closed")">Closed</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-accent">Update</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
