@model RecordsViewModel
@{
    ViewData["Title"] = "Instrument Records";
}
<h2 class="page-title"><i class="fa-solid fa-magnifying-glass me-2"></i>Instrument Records</h2>

<div class="hcim-card p-3 mb-4">
    <form asp-action="Records" method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Area</label>
            <select name="area" class="form-select" onchange="this.form.submit()">
                <option value="">All areas</option>
                @foreach (var a in Model.Areas)
                {
                    <option value="@a" selected="@(a == Model.SelectedArea)">@a</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Instrument</label>
            <select name="id" class="form-select" onchange="this.form.submit()">
                <option value="">-- select --</option>
                @foreach (var i in Model.Instruments)
                {
                    <option value="@i.Id" selected="@(Model.Selected != null && Model.Selected.Id == i.Id)">@i.Title</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Search Tag</label>
            <div class="input-group">
                <input type="text" name="search" class="form-control" value="@Model.Search" placeholder="e.g. TT.1010" />
                <button class="btn btn-navy" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>
        </div>
    </form>
</div>

@if (Model.Selected != null)
{
    var i = Model.Selected;
    <div class="hcim-card p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0" style="color:var(--navy)">@i.Title</h4>
            <span class="status-badge @UiHelpers.StatusCssClass(i.Status)">@i.Status</span>
        </div>
        <dl class="row info-grid">
            <dt class="col-sm-3">Manufacturer</dt><dd class="col-sm-3">@i.Manufacturer</dd>
            <dt class="col-sm-3">Model No</dt><dd class="col-sm-3">@i.ModelNumber</dd>
            <dt class="col-sm-3">Instrument Type</dt><dd class="col-sm-3">@i.InstrumentType</dd>
            <dt class="col-sm-3">Serial No</dt><dd class="col-sm-3">@i.SerialNumber</dd>
            <dt class="col-sm-3">MM #</dt><dd class="col-sm-3">@i.MM</dd>
            <dt class="col-sm-3">Point Type</dt><dd class="col-sm-3">@i.PointType</dd>
            <dt class="col-sm-3">Last Cal Date</dt><dd class="col-sm-3">@(i.Last_Cal_Date?.ToString("MMM d, yyyy") ?? "-")</dd>
            <dt class="col-sm-3">Next Cal Date</dt><dd class="col-sm-3">@(i.Next_Cal_Date?.ToString("MMM d, yyyy") ?? "-")</dd>
            <dt class="col-sm-3">Area</dt><dd class="col-sm-3">@i.Area</dd>
            <dt class="col-sm-3">Access</dt><dd class="col-sm-3 @UiHelpers.AccessCssClass(i.AccessRequirement)">@i.AccessRequirement</dd>
        </dl>
    </div>
}

<div class="hcim-card p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Tag</th><th>Area</th><th>Type</th><th>Manufacturer</th><th>Next Cal</th><th>Status</th></tr>
            </thead>
            <tbody>
                @if (!Model.Instruments.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No instruments found.</td></tr>
                }
                @foreach (var i in Model.Instruments)
                {
                    <tr style="cursor:pointer" onclick="location.href='@Url.Action("Records", new { area = Model.SelectedArea, id = i.Id, search = Model.Search })'">
                        <td class="fw-bold">@i.Title</td>
                        <td>@i.Area</td>
                        <td>@i.InstrumentType</td>
                        <td>@i.Manufacturer</td>
                        <td>@(i.Next_Cal_Date?.ToString("MMM d, yyyy") ?? "-")</td>
                        <td><span class="status-badge @UiHelpers.StatusCssClass(i.Status)">@i.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
